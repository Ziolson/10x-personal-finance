---
import AuthLayout from "../../layouts/AuthLayout.astro";
import ResetPasswordForm from "../../components/features/auth/ResetPasswordForm";
---

<AuthLayout title="Reset hasła | 10x Personal Finance">
  <div class="space-y-6">
    <div class="space-y-2 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Zresetuj swoje hasło</h2>
      <p class="text-sm text-muted-foreground">Wprowadź nowe hasło poniżej</p>
    </div>
    <ResetPasswordForm client:load />
  </div>
</AuthLayout>
