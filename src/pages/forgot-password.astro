---
import AuthLayout from "../layouts/AuthLayout.astro";
import ForgotPasswordForm from "../components/features/auth/ForgotPasswordForm";
---

<AuthLayout title="Zapomniane hasło | 10x Personal Finance">
  <div class="space-y-6">
    <div class="space-y-2 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Zapomniałeś hasła?</h2>
      <p class="text-sm text-muted-foreground">Wprowadź swój email, aby otrzymać link do resetowania hasła</p>
    </div>
    <ForgotPasswordForm client:load />
  </div>
</AuthLayout>
