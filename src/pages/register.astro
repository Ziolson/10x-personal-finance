---
import AuthLayout from "../layouts/AuthLayout.astro";
import RegisterForm from "../components/features/auth/RegisterForm";
---

<AuthLayout title="Rejestracja | 10x Personal Finance">
  <div class="space-y-6">
    <div class="space-y-2 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Kreator konta</h2>
      <p class="text-sm text-muted-foreground">Wprowadź swoje dane, aby utworzyć konto</p>
    </div>
    <RegisterForm client:load />
  </div>
</AuthLayout>
